# PyInstaller build intermediates (regenerated by build_exe*.bat / *.spec)
**/build/
__pycache__/
*.pyc

# Python virtual environments
.venv/
venv/

# Editor/OS/session cruft
*.tmp
*.log
*.jsonl
.DS_Store
Thumbs.db

# Local credentials and signing material
.env
.env.*
!.env.example
*.pem
*.key

# Node
node_modules/

# Locally generated release outputs
*.zip
dist_build/dist/
dist_build/translator_release/
dist_build/user_release/

# See wsr_package_build/.gitignore for the localization pipeline's own
# per-machine state exclusions (debug_output/, patch_backup/, etc.).
