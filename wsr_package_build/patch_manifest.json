    {
      "path": "js/locale/localeManager.js",
      "original_sha256": "39972ff9b12e9f6a450579f1606ed58df7e75ed3102ed3d99070a4ae2c4f97e2",
      "patched_sha256": "f93061f5ba8b74f8653e4009b9d6b919edac50d93ac86181b696ef80118d6180",
      "hunks": [
        {
          "start_line": 50,
          "delete_count": 0,
          "original_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
          "new_text": "// WSR localization: register every locale the WSR pipeline built\r\n// (locale/wsr-locales.json, generated from locale_profiles.json). Its text\r\n// is translated by the WSR runtime, so the game's dictionary stays empty.\r\ntry {\r\n    const _fs = require('fs');\r\n    const _path = require('path');\r\n    for (const dir of [\r\n        _path.join(__dirname, 'locale'), _path.join(__dirname, 'js', 'locale'),\r\n        _path.join(__dirname, '..', 'locale'), _path.join(__dirname, '..', 'js', 'locale'),\r\n    ]) {\r\n        const file = _path.join(dir, 'wsr-locales.json');\r\n        if (!_fs.existsSync(file)) continue;\r\n        for (const [code, cfg] of Object.entries(JSON.parse(_fs.readFileSync(file, 'utf8')))) {\r\n            if (!LANGUAGE_OPTIONS[code]) {\r\n                LANGUAGE_OPTIONS[code] = { name: cfg.name || code, dictionary: {}, warning: cfg.warning || '' };\r\n            }\r\n        }\r\n        break;\r\n    }\r\n} catch (e) {\r\n    console.error('[WSR] failed to load wsr-locales.json', e);\r\n}\r\n\r\n"
        }
      ]
    },
    {
      "path": "js/components/helpers.js",
      "original_sha256": "1f65417091c2248eef788ef2ab5d8852efbd0ea77b15862525d306d8ddc44662",
