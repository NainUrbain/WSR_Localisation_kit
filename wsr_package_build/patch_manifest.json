      "hunks": [
        {
          "start_line": 51,
          "delete_count": 1,
          "original_sha256": "25c91d561f1fefb18a26059e9938a79d11ec8b8e42b64e299ed2a56d7a102f4b",
          "new_text": "    const match = line && line.match(/@([A-Z]+)(\\d*(\\|\\d+)*)[\\s-]*$/);\r\n"
        },
        {
          "start_line": 220,
          "delete_count": 1,
          "original_sha256": "cf29e41236141310df4fb7f0d665a73207aa539196e6eb546ea305cff48f355e",
          "new_text": "function splitTableColumns(text) {\r\n    return text.split(/\\s{2,}/).map(s => s.trim()).filter(s => s !== '');\r\n}\r\n\r\nfunction renderTableLines(cleanedLines, onLink) {\r\n    const rows = cleanedLines.map(({ text, link }) => {\r\n        const trimmed = text.trim();\r\n        if (trimmed === '') return { kind: 'blank' };\r\n        // Same rule-line pattern localization-capture.js's isTableRow() already\r\n        // uses — some reports separate dash groups per column\r\n        // (\"------- ---------  -------  ...\") rather than one unbroken run,\r\n        // so the whitespace must be allowed inside the match too.\r\n        if (/^[-=_\\s]{6,}$/.test(trimmed)) return { kind: 'rule', text };\r\n        return { kind: 'data', cells: splitTableColumns(text), link };\r\n    });\r\n\r\n    const counts = {};\r\n    for (const r of rows) {\r\n        if (r.kind !== 'data') continue;\r\n        counts[r.cells.length] = (counts[r.cells.length] || 0) + 1;\r\n    }\r\n    let cols = 1;\r\n    let best = 0;\r\n    for (const [n, count] of Object.entries(counts)) {\r\n        if (count > best) { best = count; cols = Number(n); }\r\n    }\r\n\r\n    return html`<table class=\"fixed-width\" style=\"border-collapse:collapse;\">\r\n        <tbody>\r\n        ${rows.map((r, i) => {\r\n            if (r.kind === 'blank') {\r\n                return html`<tr key=${i}><td colspan=${cols} style=\"height:1.2em;\"> </td></tr>`;\r\n            }\r\n            if (r.kind === 'rule') {\r\n                return html`<tr key=${i}><td colspan=${cols}>${r.text}</td></tr>`;\r\n            }\r\n            const isShort = r.cells.length < cols;\r\n            const isLong = r.cells.length > cols;\r\n            const displayCells = isLong\r\n                ? [{ text: r.cells.join('  '), span: cols }]\r\n                : (isShort\r\n                    ? Array(cols - r.cells.length).fill(0).map(() => ({ text: '' })).concat(r.cells.map(c => ({ text: c })))\r\n                    : r.cells.map(c => ({ text: c })));\r\n            const idFound = r.link?.id > 0 || (r.link?.id && r.link?.id.includes?.('|'));\r\n            const linkData = idFound && Number.isInteger(r.link?.id) && r.link.id > 0\r\n                ? (r.link.type === 'C' ? { 'data-company-id': r.link.id }\r\n                  : r.link.type === 'I' ? { 'data-industry-id': r.link.id }\r\n                  : {})\r\n                : {};\r\n            const handler = idFound ? () => onLink && onLink(r.link) : null;\r\n            const rowClass = idFound && onLink ? 'cursor-pointer text-blue-400 hover:bg-blue-700' : '';\r\n            return html`<tr key=${i} class=${rowClass} onClick=${handler} ...${linkData}>\r\n                ${displayCells.map((c, j) => html`<td key=${j} colspan=${c.span || 1} style=\"padding:0 0.8em 0 0; white-space:pre;\">${c.text}</td>`)}\r\n            </tr>`;\r\n        })}\r\n        </tbody>\r\n    </table>`;\r\n}\r\n\r\nexport function renderLines(lines, onLink, renderExtras, hyperlinkRegex, textMatch, extrasStartNumber, scopeActiveRef, extrasAlign, tableMode) {\r\n"
        },
        {
          "start_line": 223,
          "delete_count": 0,
          "original_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
          "new_text": "    const expandedLines = lines.flatMap(line => {\r\n        if (typeof line !== 'string') return [line];\r\n        const markers = [...line.matchAll(/@[A-Z]+\\d*(?:\\|\\d+)*/g)];\r\n        if (markers.length <= 1) return [line];\r\n        const segments = [];\r\n        let prevEnd = 0;\r\n        for (const m of markers) {\r\n            const segEnd = m.index + m[0].length;\r\n            segments.push(line.slice(prevEnd, segEnd).trim());\r\n            prevEnd = segEnd;\r\n        }\r\n        // Any leftover text after the LAST marker (not expected in\r\n        // practice, but keep it rather than silently drop it) rides along\r\n        // on the final segment.\r\n        const trailing = line.slice(prevEnd).trim();\r\n        if (trailing && segments.length) segments[segments.length - 1] += ' ' + trailing;\r\n        return segments;\r\n    });\r\n\r\n"
        },
        {
          "start_line": 224,
          "delete_count": 1,
          "original_sha256": "b442771377aef73a0f6b70a8697373d1c3d6ec27b85d1a5b42ed8ea6b75ca091",
          "new_text": "    const cleanedLines = expandedLines.map(line => {\r\n"
        },
        {
          "start_line": 228,
          "delete_count": 1,
          "original_sha256": "5b41cfc7b7079dfce99c42ff868efe0522c656a821f00ce00da175f5575b2210",
          "new_text": "        clean = link ? clean.replace(/@[A-Z]+\\d*(?:\\|\\d+)*[\\s-]*$/, '').trimEnd() : clean;\r\n"
        },
        {
          "start_line": 233,
          "delete_count": 0,
          "original_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
          "new_text": "\r\n    if (tableMode) {\r\n        return renderTableLines(cleanedLines, onLink);\r\n    }\r\n"
        }
      ]
